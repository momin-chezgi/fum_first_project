{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "g++", 
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}${exeExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\g++.exe"
            },
            "linux": {
                "command": "/usr/bin/g++"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}